{
  "hosting": [
    {
      "target": "portal",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "censo/**",
        "Portal de Estudos CIESL.html",
        "redirect-antigo/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/Portal_pessoal.html"
        },
        {
          "source": "/cadastro",
          "destination": "/cadastro.html"
        }
      ]
    },
    {
      "target": "censo",
      "public": "censo",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/Atualização cadastral.html"
        }
      ]
    },
    {
      "target": "portal-antigo",
      "public": "redirect-antigo",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/:caminho*",
          "destination": "https://portal-de-estudos.web.app/:caminho",
          "type": 301
        }
      ]
    }
  ]
}
