{
  "hosting": [
    {
      "target": "portal",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "censo/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/Portal_pessoal.html"
        },
        {
          "source": "/cadastro",
          "destination": "/cadastro.html"
        }
      ]
    },
    {
      "target": "censo",
      "public": "censo",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/Atualização cadastral.html"
        }
      ]
    }
  ]
}
